PORT=3004
FLASK_APP=wsgi:app
# Use 3004 when running via `flask run` (Flask CLI defaults to 5000)
FLASK_RUN_PORT=3004

# JWT validation (use same secret as auth service that issues tokens)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRES=3600

# Request/response logging
LOG_LEVEL=INFO
# LOG_REQUEST_BODY_MAX_LENGTH=2048
# LOG_RESPONSE_BODY_MAX_LENGTH=2048

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=master_data_db
